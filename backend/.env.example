# =============================================================================
# HomeEase 2.0 — пример переменных окружения (backend)
# Скопируйте: cp .env.example .env  и заполните значения.
# =============================================================================
#
# PRODUCTION (обязательно перед публичным релизом):
#   APP_ENV=production
#   SUBSCRIPTION_ENFORCE=true
#   JWT_SECRET=<случайная_строка>     # openssl rand -hex 32
#   CRON_SECRET=<случайная_строка>    # openssl rand -hex 32
#   CORS_ORIGINS=https://ваш-домен,https://www.ваш-домен
#   SENTRY_DSN=https://...@sentry.io/...   (опционально, мониторинг ошибок)
#
# Генерация секретов (Linux/macOS/Git Bash):
#   openssl rand -hex 32
# Windows PowerShell:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# =============================================================================

# --- База данных и кэш ---
# Docker Compose: postgres / redis. Локально без Docker: localhost
DATABASE_URL=postgresql+asyncpg://homeease:CHANGE_ME_DB_PASSWORD@postgres:5432/homeease
REDIS_URL=redis://redis:6379/0

# --- Безопасность ---
# НЕ используйте dev-secret / change-me в production!
# Сгенерируйте: openssl rand -hex 32
JWT_SECRET=GENERATE_WITH_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- CORS ---
# Development:
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000
# Production (пример):
# CORS_ORIGINS=https://app.homeease.ru,https://www.homeease.ru

# --- Геолокация ---
IP_GEO_API_URL=http://ip-api.com/json

# --- Реферальная программа ---
REFERRAL_BONUS_REFERRER=50
REFERRAL_BONUS_REFEREE=20

# --- Внутренние задачи (cron) ---
# Сгенерируйте: openssl rand -hex 32
CRON_SECRET=GENERATE_WITH_openssl_rand_hex_32

# --- Push (FCM) ---
FCM_SERVER_KEY=

# --- Планировщик ---
ENABLE_SCHEDULER=true

# --- Окружение ---
APP_ENV=development
# APP_ENV=production

# --- Sentry (только production, опционально) ---
# Получить DSN: https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=

# --- Подписка ---
TRIAL_DAYS=14
SUBSCRIPTION_ENFORCE=true
# В dev можно отключить: SUBSCRIPTION_ENFORCE=false

# --- Платёжный провайдер ---
# yookassa (по умолчанию) | rustore | tbank | stripe | mock
PAYMENT_PROVIDER=yookassa

# --- YooKassa ---
# 1. Регистрация: https://yookassa.ru → подключить магазин
# 2. Личный кабинет → Интеграция → Ключи API
# 3. Скопировать shopId (числовой) и секретный ключ (test_... для тестов)
# 4. Webhook URL: https://ваш-домен/api/v1/webhook/yookassa
#    События: payment.succeeded, payment.canceled, payment.waiting_for_capture
# 5. Проверка: python -m scripts.test_webhook --email test@example.com --password Test1234
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# --- URL возврата после оплаты ---
# Web (production):
# PAYMENT_SUCCESS_URL=https://app.homeease.ru/subscription/success
# PAYMENT_CANCEL_URL=https://app.homeease.ru/subscription/cancel
# Mobile deep links:
# PAYMENT_SUCCESS_URL=homeease://payment/success
# PAYMENT_CANCEL_URL=homeease://payment/cancel
PAYMENT_SUCCESS_URL=http://localhost:8081/subscription/success
PAYMENT_CANCEL_URL=http://localhost:8081/subscription/cancel

# --- Stripe (опционально, PAYMENT_PROVIDER=stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8081/subscription/success
STRIPE_CANCEL_URL=http://localhost:8081/subscription/cancel
STRIPE_PRICE_MONTHLY_RU=
STRIPE_PRICE_YEARLY_RU=
STRIPE_PRICE_MONTHLY_KZ=
STRIPE_PRICE_YEARLY_KZ=
STRIPE_PRICE_MONTHLY_UZ=
STRIPE_PRICE_YEARLY_UZ=
STRIPE_PRICE_MONTHLY_TJ=
STRIPE_PRICE_YEARLY_TJ=
STRIPE_PRICE_MONTHLY_GE=
STRIPE_PRICE_YEARLY_GE=
STRIPE_PRICE_MONTHLY_KG=
STRIPE_PRICE_YEARLY_KG=

# --- RuStore (альтернатива, Android, PAYMENT_PROVIDER=rustore) ---
# Требует RuStore Console, Pay SDK в мобильном приложении и webhook.
# Документация: https://www.rustore.ru/help/sdk/pay
RUSTORE_APP_ID=
RUSTORE_PACKAGE_NAME=com.homeease.app
RUSTORE_API_KEY=
RUSTORE_WEBHOOK_SECRET=
RUSTORE_SANDBOX=true
RUSTORE_PRODUCT_MONTHLY=homeease_monthly
RUSTORE_PRODUCT_YEARLY=homeease_yearly

# --- Т-Банк (альтернатива, PAYMENT_PROVIDER=tbank) ---
# Требует подключение интернет-эквайринга: https://www.tbank.ru/kassa/
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2

# --- Frontend (Expo) — скопируйте в frontend/.env ---
# EXPO_PUBLIC_API_URL=https://api.ваш-домен
# EXPO_PUBLIC_SENTRY_DSN=
