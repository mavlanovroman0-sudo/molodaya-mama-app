# HomeEase 2.0 — шаблон .env (скопируйте: cp .env.template .env)
#
# PRODUCTION:
#   APP_ENV=production
#   SUBSCRIPTION_ENFORCE=true
#   JWT_SECRET=$(openssl rand -hex 32)
#   CRON_SECRET=$(openssl rand -hex 32)
#   CORS_ORIGINS=https://ваш-домен,https://www.ваш-домен
#   SENTRY_DSN=...  (опционально)

DATABASE_URL=postgresql+asyncpg://homeease:CHANGE_ME@postgres:5432/homeease
REDIS_URL=redis://redis:6379/0

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
OPENAI_API_KEY=
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
IP_GEO_API_URL=http://ip-api.com/json
REFERRAL_BONUS_REFERRER=50
REFERRAL_BONUS_REFEREE=20
CRON_SECRET=
FCM_SERVER_KEY=
ENABLE_SCHEDULER=true

APP_ENV=development
SENTRY_DSN=

TRIAL_DAYS=14
SUBSCRIPTION_ENFORCE=true

PAYMENT_PROVIDER=yookassa

# YooKassa: https://yookassa.ru → Интеграция → Ключи API
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

PAYMENT_SUCCESS_URL=http://localhost:8081/subscription/success
PAYMENT_CANCEL_URL=http://localhost:8081/subscription/cancel

# RuStore (PAYMENT_PROVIDER=rustore) — дополнительная настройка Android SDK
RUSTORE_APP_ID=
RUSTORE_PACKAGE_NAME=com.homeease.app
RUSTORE_API_KEY=
RUSTORE_WEBHOOK_SECRET=
RUSTORE_SANDBOX=true
RUSTORE_PRODUCT_MONTHLY=homeease_monthly
RUSTORE_PRODUCT_YEARLY=homeease_yearly

# Т-Банк (PAYMENT_PROVIDER=tbank) — дополнительная настройка эквайринга
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_URL=https://securepay.tinkoff.ru/v2

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
